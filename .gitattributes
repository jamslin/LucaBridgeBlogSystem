# Normalise line endings. Text is stored as LF in the repository and checked out
# as LF everywhere, so a Windows and a Linux clone produce identical diffs.
* text=auto eol=lf

# Windows scripts must keep CRLF — cmd.exe mishandles LF in labels and goto.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF even when edited on Windows.
*.sh  text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.jar  binary
